# pos360-edge — configuración
#
# Valores tal como están en producción al 2026-07-25 (app CapRover
# `pos360-edge`, dominio propio sanjuantecnologia.com).
#
# NINGUNA de estas variables es secreta: son rutas, upstreams internos de la
# red de Docker Swarm y defaults de Open Graph. Si en el futuro se agrega
# alguna credencial, va en el panel de CapRover y NO en este archivo.

NODE_ENV=production
PORT=3000

# Origen público que se usa para armar URLs absolutas (canonical, og:url).
PUBLIC_BASE_URL=https://sanjuantecnologia.com
PROXY_LOG_LEVEL=warn

# ── Upstreams ─────────────────────────────────────────────────────────────
# OJO: hoy /shop/, /app/ y /assets/ apuntan TODOS acá. Si alguna vez se
# separa la tienda del backoffice (por ejemplo migrando la tienda a SSR),
# hay que partir esto en dos upstreams distintos en src/proxy/proxies.js.
SHOP_UPSTREAM=http://srv-captain--pos360-frontend
API_ORIGIN=http://srv-captain--pos360-commerce-api:3000

# Prefijo donde el frontend sirve la tienda dentro de su propio build.
FRONTEND_INDEX_PATH=/shop/

# ── Open Graph ────────────────────────────────────────────────────────────
# Sucursal de la que se toman precios y stock para las tarjetas de producto.
OG_BRANCH_ID=3
OG_TITLE_INCLUDE_PRICE=1
OG_PRICE_CURRENCY_DEFAULT=ARS
OG_IMAGE_DEFAULT=https://storage-files.cingulado.org/pos360/shop/og-default.jpg
FAVICON_DEFAULT=https://storage-files.cingulado.org/pos360/shop/favicon.png

# --- Suspension administrativa del backoffice (/app/) ---
# Apagado por defecto. Corta el acceso al POS sin tocar la tienda ni la base.
# APP_SUSPENDIDO=0
# APP_SUSPENDIDO_FILE=/data/app-suspendido
# SUSPENSION_TITULO=Servicio suspendido
# SUSPENSION_MENSAJE=El acceso al panel de gestión está suspendido temporalmente. Para reactivarlo, comunicate con el administrador del sistema.
# SUSPENSION_CONTACTO_TEXTO=
# SUSPENSION_CONTACTO_HREF=
# SUSPENSION_CONTACTO_BOTON=Contactar
# SUSPENSION_RETRY_AFTER=3600
